PORT=3000
DATABASE_URL=postgres://sacdau_user:sacdau_dev_pw@localhost:5433/sacdau
MQTT_BROKER_URL=mqtt://localhost:1883
FRONTEND_URL=http://localhost:5173
JWT_SECRET=change_me
JWT_REFRESH_SECRET=change_me_khac_JWT_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# So lan dang ky tai khoan / gio / IP (mac dinh 10)
REGISTER_RATE_LIMIT=10

# Muc log: trace|debug|info|warn|error|silent (mac dinh info, test tu dong silent)
LOG_LEVEL=info

# DB rieng cho jest (moi lan test se xoa sach bang users) - tao 1 lan: docker exec sacdau_postgres psql -U sacdau_user -d sacdau -c "CREATE DATABASE sacdau_test;" roi npm run test:db:migrate
TEST_DATABASE_URL=postgres://sacdau_user:sacdau_dev_pw@localhost:5433/sacdau_test

# VNPay sandbox - tu dang ky tai sandbox.vnpayment.vn de lay TMN_CODE + HASH_SECRET
VNPAY_TMN_CODE=change_me
VNPAY_HASH_SECRET=change_me
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/payments/vnpay-return

# Don gia dien (VND/kWh), chup vao charging_sessions.unit_price luc mo phien
# (xem docs/contracts.md muc 1, them 2026-10-29 - mo hinh nghiep vu moi)
UNIT_PRICE_PER_KWH=3500

# Luong nghiep vu (2026-11-18, docs/LUONG_NGHIEP_VU.md) - cac hang so con lai nam o src/config/rules.js
# Coc giu cho tra qua VNPay khi dat (VND)
BOOKING_DEPOSIT_VND=20000
# Phi chiem cho khi xe day pin ma chua rut sung (VND/phut, tran VND)
IDLE_FEE_PER_MIN=1000
IDLE_FEE_CAP=100000
# Gio phuc vu (gio Viet Nam): booking phai nam tron trong khung nay
SERVICE_OPEN_HOUR=6
SERVICE_CLOSE_HOUR=22

# Tai khoan MQTT cua backend (broker bat buoc dang nhap, xem mosquitto/README.md)
MQTT_USERNAME=sacdau_backend
MQTT_PASSWORD=change_me
