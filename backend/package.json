{
  "name": "sacdau-backend",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node-pg-migrate",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "test": "jest --runInBand --forceExit",
    "test:db:migrate": "node-pg-migrate up -d TEST_DATABASE_URL",
    "create-admin": "node src/scripts/create-admin.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.22.3",
    "express-rate-limit": "8.7.1",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.3",
    "mqtt": "5.16.1",
    "pg": "8.13.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "pino-pretty": "13.2.0",
    "ws": "8.22.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "jest": "30.5.2",
    "node-pg-migrate": "7.9.1",
    "supertest": "7.3.1"
  }
}
